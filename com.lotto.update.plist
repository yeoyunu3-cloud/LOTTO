<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lotto.update</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/yeoyun-u/개인개발/LOTTO/lotto_sync.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/yeoyun-u/개인개발/LOTTO</string>
    <!-- 수집은 GitHub Actions가 함. 맥은 로그인할 때 + 토요일 23:30에 받아오기만 -->
    <key>RunAtLoad</key>
    <true/>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>6</integer>
        <key>Hour</key>
        <integer>23</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/yeoyun-u/개인개발/LOTTO/lotto_update.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/yeoyun-u/개인개발/LOTTO/lotto_update.log</string>
</dict>
</plist>
